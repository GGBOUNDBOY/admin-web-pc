# Normalize line endings: always LF in the repository and in the working tree,
# so Windows (CRLF) and Linux/macOS (LF) never produce LF/CRLF warnings.
* text=auto eol=lf

# Web sources
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Windows scripts
*.cmd  text eol=lf
*.bat  text eol=lf
*.ps1  text eol=lf

# Binaries
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.svgz binary
